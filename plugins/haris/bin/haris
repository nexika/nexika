#!/usr/bin/env python3
"""haris launcher (hooks call it with `hook ...`; users and skills with why/status/audit/check)."""
import os
import sys

# Inside a family background model call (#45) the context hooks stay quiet; the tool guard never does.
if sys.argv[1:3] in (["hook", "session-start"], ["hook", "user-prompt-submit"], ["hook", "stop"]) \
        and os.environ.get("NEXIKA_BACKGROUND") == "1":
    sys.exit(0)

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir))

from haris.cli import entry  # noqa: E402

entry()
