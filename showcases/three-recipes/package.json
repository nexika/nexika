{
  "name": "lawha-showcase-three-recipes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "lawha's Three.js recipes (WaveField, GradientFlow, FloatingShapes) in the prof 'Ink and saffron' tokens, checked with lawha check including reduced motion.",
  "scripts": {
    "recipes": "mkdir -p src/three && cp ../../plugins/lawha/recipes/three/*.tsx src/three/",
